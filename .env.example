# Copy this file to .env and fill in your own values.
# Never commit your real .env file -- it is already listed in .gitignore.

# --- LLM provider ---
# Which provider to use: openai | anthropic | mock (mock is for offline tests, see tests/)
LLM_PROVIDER=openai
# Model name for the chosen provider, e.g. gpt-4o-mini, gpt-4o, claude-sonnet-5
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Cost / runaway-loop controls ---
# Maximum number of observe-think-act steps per task before giving up.
MAX_STEPS=20
# Per-step Playwright timeout, in milliseconds.
STEP_TIMEOUT_MS=15000
# How much visible page text (characters) is sent to the LLM per step.
MAX_DOM_CHARS=6000

# --- Browser behaviour ---
# false = show the Chrome window (recommended while learning how the agent works)
HEADLESS=false
# Playwright channel for the real, locally installed Google Chrome.
CHROME_CHANNEL=chrome
# Leave blank to use CHROME_CHANNEL above. Set this only if Chrome is
# installed somewhere Playwright can't find automatically.
CHROME_EXECUTABLE_PATH=
# Folder used as a persistent Chrome profile, so logins/cookies you set up
# manually are remembered between runs. Default: ./chrome_profile
CHROME_USER_DATA_DIR=
USE_PERSISTENT_PROFILE=true

# --- Safety ---
# When true, the agent asks for [y/n] confirmation before actions that look
# like they submit forms, send messages, make purchases, or delete data.
CONFIRM_SENSITIVE_ACTIONS=true
