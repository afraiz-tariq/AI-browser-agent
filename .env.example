# Copy this file to .env and fill in your own values.
# Never commit your real .env file -- it is already listed in .gitignore.

# --- LLM provider ---
# Which provider to use: anthropic | openai | mock (mock is for offline tests, see tests/)
LLM_PROVIDER=anthropic
# Model name for the chosen provider, e.g. claude-sonnet-5, claude-haiku-4-5, gpt-4o-mini
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
# How many times the SDK itself retries a request (connection errors,
# timeouts, 429s, 5xx) before giving up. 2 matches both SDKs' own default.
LLM_MAX_RETRIES=2

# --- Optional faster decider for browser steps (see jev.py and docs/JEV_VOICE_PLAN.md) ---
# claude = every step decided by the LLM above (default, unchanged behaviour).
# hybrid = TypeSafe's Jev picks click/type/scroll steps on web pages (much
#          faster per step); the LLM above still handles everything else and
#          any step Jev is unsure of. Page text and element labels are sent to
#          TypeSafe on those steps (secret fields are masked first).
DECIDER=claude
# Key from https://console.typesafe.ai -- only needed for DECIDER=hybrid.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Below this confidence Jev's pick is ignored and the LLM above decides.
JEV_MIN_CONFIDENCE=0.5

# --- Cost / runaway-loop controls ---
# Maximum number of observe-think-act steps per task before giving up.
MAX_STEPS=20
# Per-step Playwright timeout, in milliseconds.
STEP_TIMEOUT_MS=15000
# How much visible page text (characters) is sent to the LLM per step.
MAX_DOM_CHARS=6000

# --- Browser behaviour ---
# false = show the Chrome window (recommended while learning how the agent works)
HEADLESS=false
# Playwright channel for the real, locally installed Google Chrome.
CHROME_CHANNEL=chrome
# Leave blank to use CHROME_CHANNEL above. Set this only if Chrome is
# installed somewhere Playwright can't find automatically.
CHROME_EXECUTABLE_PATH=
# Folder used as a persistent Chrome profile, so logins/cookies you set up
# manually are remembered between runs. Default: ./chrome_profile
CHROME_USER_DATA_DIR=
USE_PERSISTENT_PROFILE=true

# --- Voice (python voice.py) -- needs: pip install faster-whisper sounddevice pyttsx3 ---
# Hold this key while speaking (ctrl_r, alt_gr, f9, scroll_lock, ... -- `python voice.py --keys` shows names).
VOICE_PTT_KEY=ctrl_r
# Press to stop a running task before its next action.
VOICE_STOP_KEY=f10
# Local speech-to-text model: tiny.en (fastest), base.en, small.en (most accurate).
# For other languages use a multilingual model (e.g. base) and set VOICE_LANGUAGE.
VOICE_WHISPER_MODEL=base.en
VOICE_LANGUAGE=en

# --- Safety ---
# When true, the agent asks for [y/n] confirmation before actions that look
# like they submit forms, send messages, make purchases, or delete data.
CONFIRM_SENSITIVE_ACTIONS=true
# When true, also confirm reversible, in-memory-only writes (e.g.
# excel_write_cell). Off by default -- undoing these is as simple as not
# saving/persisting the change.
CONFIRM_R1_ACTIONS=false

# --- MCP (Model Context Protocol) arms -- see mcp_tools.py ---
# Adds a read-only arm: web-fetch via the official MCP "fetch" reference
# server. Additive, off by default. Turn on after running
# `pip install mcp mcp-server-fetch`.
ENABLE_MCP_FETCH=false
# Command used to launch the fetch MCP server. Default assumes the
# `mcp-server-fetch` console script is on PATH after pip install; override
# if you run it a different way (e.g. `uvx mcp-server-fetch`).
MCP_FETCH_COMMAND=mcp-server-fetch

# Adds a second read-only arm: Brave web/local/video/image/news search.
# Additive, off by default. Needs Node.js (run via npx) and a free API key
# from https://brave.com/search/api/ -- Brave's free tier is enough to try
# this out.
ENABLE_MCP_BRAVE_SEARCH=false
BRAVE_API_KEY=

# Adds a third read-only arm: read/list/search files in ONE local folder
# you name below. Additive, off by default. Needs Node.js (run via npx).
# There is deliberately no default folder -- pick one you're comfortable
# the agent being able to read from (writing to it is still possible but
# always asks for confirmation first, same as excel_save).
ENABLE_MCP_FILESYSTEM=false
MCP_FILESYSTEM_ROOT=

# How long (seconds) to wait for an MCP server to start before giving up.
# 90s by default -- an npx-launched server can do a real network round-trip
# on every invocation even when already cached locally; raise this if
# that's consistently too slow on your connection.
MCP_STARTUP_TIMEOUT_S=90

# --- Windows desktop automation arm (windows_tools.py) ---
# Off by default. Launch-app + list/click/type/read-controls only, scoped
# down deliberately (see ARCHITECTURE_DECISIONS.md section 5) -- not a
# general "control any window" tool. Every mutating action ALWAYS asks for
# confirmation regardless of CONFIRM_SENSITIVE_ACTIONS/CONFIRM_R1_ACTIONS,
# since there's no browser-DOM-equivalent ground truth to justify a lower
# tier for any specific windows_* action. Windows-only; requires
# `pip install pywinauto`.
ENABLE_WINDOWS_AUTOMATION=false

# --- Discord bot interface (discord_bot.py) ---
# Bot token from https://discord.com/developers/applications -> your app ->
# Bot tab -> Reset/Copy Token. Remember to enable the "Message Content
# Intent" toggle on that same tab, or the bot won't see message text at all.
DISCORD_BOT_TOKEN=
# Your Discord user ID (Discord app -> Settings -> Advanced -> enable
# Developer Mode, then right-click your own name -> Copy User ID). The bot
# only ever acts on messages from this exact user; everyone else is ignored.
DISCORD_ALLOWED_USER_ID=
